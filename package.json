{
  "name": "blue-below",
  "version": "1.0.0",
  "private": true,
  "description": "Blue Below - a short first-person survival horror game in the style of a late-1990s PlayStation title.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "play": "bash play.sh",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:test": "tsc --noEmit && vite build --mode test",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:test && node test/run-routes.mjs",
    "test:headed": "npm run build:test && node test/run-routes.mjs --headed",
    "test:only": "node test/run-routes.mjs",
    "verify:release": "npm run build && node test/release-check.mjs",
    "cf:dev": "npm run build && node test/cf-preflight.mjs && wrangler dev --ip 127.0.0.1 --port 8787",
    "cf:check": "npm run build && wrangler deploy --dry-run",
    "cf:deploy": "npm run verify:release && wrangler deploy"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "playwright": "^1.65.1",
    "typescript": "5.9.3",
    "vite": "^8.3.8",
    "wrangler": "^4.163.0"
  }
}
